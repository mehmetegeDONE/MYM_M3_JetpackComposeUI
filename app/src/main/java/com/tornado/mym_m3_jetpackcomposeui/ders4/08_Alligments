----------------------------------------------------------------------------------------------------
horizontal -> X ekseni (Genişlik)
vertical -> Y ekseni (Yukseklik)
----------------------------------------------------------------------------------------------------

// Box
contentAlignment = Alignment.Center

// Row
horizontalArrangement = Arrangement.Center                                     -> Elemanları ortalar
horizontalArrangement = Arrangement.SpaceBetween                 -> Elemanları eşit aralıkta dağıtır
verticalAlignment = Alignment.CenterVertically

// Column
horizontalAlignment = Alignment.CenterHorizontally
verticalArrangement = Arrangement.Center

// LazyColumn - LazyRow
horizontalArrangement = Arrangement.spacedBy()                            -> X'de items arası bosluk
                                space = 12.dp

verticalArrangement = Arrangement.spacedBy()                                    -> Y'de items boşluk
                                space = 12.dp


// Text
textAlign = TextAlign.End         (modifier = Modifier.fillMaxWidth() kullanmalısın) -> Saga hizlama
textAlign = TextAlign.Center      (modifier = Modifier.fillMaxWidth() kullanmalısın) -> Orta hizlama
textAlign = TextAlign.Start       (modifier = Modifier.fillMaxWidth() kullanmalısın) -> Sola hizlama

modifier = Modifier.fillMaxWidth() kullanma sebebin: textin kendisi kadar yer kaplaması,
                                                                        o yüzden saga sola gidemez.